      "    ('${1:name_uniq}', 'unique(${2:name})', '${3:The name must be unique!}'),",
      "]"
    ],
    "description": "Odoo _sql_constraints definition"
  },
  "Odoo TransactionCase Test": {
    "prefix": "otestcase",
    "body": [
      "from odoo.tests.common import TransactionCase, tagged",
