  },
  "Odoo Return Window Action Method": {
    "prefix": "oactwin",
    "body": [
      "def action_${1:open_records}(self):",
      "    self.ensure_one()",
      "    return {",
      "        'name': _('${2:Records}'),",
      "        'type': 'ir.actions.act_window',",
      "        'res_model': '${3:model.name}',",
      "        'view_mode': 'list,form',",
      "        'domain': [('${4:parent_id}', '=', self.id)],",
      "        'context': {'default_${4:parent_id}': self.id},",
      "    }"
    ],
    "description": "Button action returning an act_window dictionary"
  },
