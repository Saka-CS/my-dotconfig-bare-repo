    "prefix": "ofo2m",
    "body": [
      "${1:line_ids} = fields.One2many(",
      "    comodel_name='${2:model.line}',",
      "    inverse_name='${3:parent_id}',",
      "    string='${4:Lines}',",
      ")"
    ],
    "description": "One2many Field definition"
  },
  "Odoo Many2many Field": {
    "prefix": "ofm2m",
    "body": [
