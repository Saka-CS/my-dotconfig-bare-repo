{
  "Odoo 17/18 Manifest": {
    "prefix": "oman",
    "body": [
      "{",
      "    'name': '${1:Module Name}',",
      "    'version': '${2:18.0.1.0.0}',",
      "    'category': '${3:Custom}',",
      "    'summary': '${4:Module Summary}',",
      "    'description': \"\"\"${5:Detailed Description}\"\"\",",
      "    'author': '${6:Author / Company}',",
      "    'website': '${7:https://www.example.com}',",
      "    'license': 'LGPL-3',",
      "    'depends': ['${8:base}'],",
      "    'data': [",
      "        'security/ir.model.access.csv',",
      "        'views/${9:model_views}.xml',",
      "    ],",
      "    'assets': {",
      "        'web.assets_backend': [",
      "            '${10:module_name}/static/src/**/*',",
      "        ],",
      "    },",
      "    'installable': True,",
      "    'application': ${11|False,True|},",
      "    'auto_install': False,",
      "}"
    ],
    "description": "Odoo 17/18 __manifest__.py boilerplate"
  },
  "Odoo 17/18 Model (Full File)": {
    "prefix": "omod",
    "body": [
      "from odoo import api, fields, models, _",
      "from odoo.exceptions import UserError, ValidationError",
      "",
      "",
      "class ${1:ClassName}(models.Model):",
      "    _name = '${2:model.name}'",
      "    _description = '${3:Model Description}'",
      "    _order = 'id desc'",
      "",
      "    name = fields.Char(string='Name', required=True)",
      "    active = fields.Boolean(default=True)",
      "    $0"
    ],
    "description": "Odoo 17/18 Standard Model Definition with Imports"
  },
  "Odoo 17/18 Model with Chatter Mixins": {
    "prefix": "omodmail",
    "body": [
      "from odoo import api, fields, models, _",
      "from odoo.exceptions import UserError, ValidationError",
      "",
      "",
      "class ${1:ClassName}(models.Model):",
      "    _name = '${2:model.name}'",
      "    _inherit = ['mail.thread', 'mail.activity.mixin']",
      "    _description = '${3:Model Description}'",
      "    _order = 'id desc'",
      "",
      "    name = fields.Char(string='Name', required=True, tracking=True)",
      "    state = fields.Selection(",
      "        selection=[",
      "            ('draft', 'Draft'),",
      "            ('done', 'Done'),",
      "        ],",
      "        string='Status',",
      "        default='draft',",
      "        tracking=True,",
      "    )",
      "    active = fields.Boolean(default=True)",
      "    $0"
    ],
    "description": "Odoo Model with Chatter (mail.thread & mail.activity.mixin)"
  },
  "Odoo 17/18 TransientModel (Wizard)": {
    "prefix": "owizard",
    "body": [
      "from odoo import api, fields, models, _",
      "from odoo.exceptions import UserError, ValidationError",
      "",
      "",
      "class ${1:WizardName}(models.TransientModel):",
      "    _name = '${2:wizard.model.name}'",
      "    _description = '${3:Wizard Description}'",
      "",
      "    ${4:partner_id} = fields.Many2one('res.partner', string='Partner')",
      "",
      "    def action_confirm(self):",
      "        self.ensure_one()",
      "        $0",
      "        return {'type': 'ir.actions.act_window_close'}"
    ],
    "description": "Odoo TransientModel (Wizard) Definition"
  },
  "Odoo 17/18 Model Inherit": {
    "prefix": "omodi",
    "body": [
      "class ${1:ClassName}(models.Model):",
      "    _inherit = '${2:inherited.model}'",
      "",
      "    $0"
    ],
    "description": "Odoo Model Inheritance"
  },
  "Odoo 17/18 Compute Display Name": {
    "prefix": "odisplayname",
    "body": [
      "@api.depends('${1:name}')",
      "def _compute_display_name(self):",
      "    for record in self:",
      "        record.display_name = f\"{record.${1:name}}\"$0"
    ],
    "description": "Odoo 17/18 _compute_display_name (replaces name_get)"
  },
  "Odoo 17/18 Multi Create": {
    "prefix": "ocreate",
    "body": [
      "@api.model_create_multi",
      "def create(self, vals_list):",
      "    for vals in vals_list:",
      "        $1",
      "    return super().create(vals_list)"
    ],
    "description": "Odoo 17/18 @api.model_create_multi create"
  },
  "Odoo Write": {
    "prefix": "owrite",
    "body": [
      "def write(self, vals):",
      "    $1",
      "    return super().write(vals)"
    ],
    "description": "Odoo write method"
  },
  "Odoo Unlink": {
    "prefix": "ounlink",
    "body": [
      "def unlink(self):",
      "    for record in self:",
      "        if record.${1:state} not in ('${2:draft}', '${3:cancel}'):",
      "            raise UserError(_('${4:You cannot delete a record that is not in draft or cancel state.}'))",
      "    return super().unlink()"
    ],
    "description": "Odoo unlink method with state check"
  },
  "Odoo Default Get": {
    "prefix": "odefaultget",
    "body": [
      "@api.model",
      "def default_get(self, fields_list):",
      "    res = super().default_get(fields_list)",
      "    $0",
      "    return res"
    ],
    "description": "Odoo default_get method"
  },
  "Odoo Onchange Method": {
    "prefix": "oonchange",
    "body": [
      "@api.onchange('${1:field_name}')",
      "def _onchange_${1:field_name}(self):",
      "    if self.${1:field_name}:",
      "        self.${2:target_field} = self.${1:field_name}.${3:source_field}$0"
    ],
    "description": "Odoo @api.onchange method"
  },
  "Odoo Constrains Method": {
    "prefix": "oconstrain",
    "body": [
      "@api.constrains('${1:field_name}')",
      "def _check_${1:field_name}(self):",
      "    for record in self:",
      "        if ${2:not record.field_name}:",
      "            raise ValidationError(_('${3:Validation error message.}'))"
    ],
    "description": "Odoo @api.constrains validation method"
  },
  "Odoo Char Field": {
    "prefix": "ofchar",
    "body": [
      "${1:name} = fields.Char(",
      "    string='${2:Label}',",
      "    required=${3|False,True|},",
      "    index=${4|False,True|},",
      ")"
    ],
    "description": "Char Field definition"
  },
  "Odoo Integer Field": {
    "prefix": "ofint",
    "body": [
      "${1:sequence} = fields.Integer(",
      "    string='${2:Sequence}',",
      "    default=${3:10},",
      ")"
    ],
    "description": "Integer Field definition"
  },
  "Odoo Float Field": {
    "prefix": "offloat",
    "body": [
      "${1:amount} = fields.Float(",
      "    string='${2:Amount}',",
      "    digits='${3:Product Price}',",
      ")"
    ],
    "description": "Float Field definition"
  },
  "Odoo Monetary Field": {
    "prefix": "ofmon",
    "body": [
      "currency_id = fields.Many2one(",
      "    comodel_name='res.currency',",
      "    string='Currency',",
      "    default=lambda self: self.env.company.currency_id,",
      ")",
      "${1:amount} = fields.Monetary(",
      "    string='${2:Amount}',",
      "    currency_field='currency_id',",
      ")"
    ],
    "description": "Monetary Field with Currency definition"
  },
