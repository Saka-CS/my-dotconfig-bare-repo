      "    comodel_name='${2:model.tag}',",
      "    string='${3:Tags}',",
      ")"
    ],
    "description": "Many2many Field definition"
  },
  "Odoo Selection Field": {
    "prefix": "ofsel",
    "body": [
      "${1:state} = fields.Selection(",
      "    selection=[",
      "        ('${2:draft}', '${3:Draft}'),",
      "        ('${4:done}', '${5:Done}'),",
      "    ],",
      "    string='${6:Status}',",
      "    default='${2:draft}',",
      "    required=True,",
      "    tracking=True,",
      ")"
    ],
    "description": "Selection Field definition with tracking"
  },
  "Odoo Compute Field": {
    "prefix": "ofcomp",
    "body": [
      "${1:total_amount} = fields.Float(",
      "    string='${2:Total Amount}',",
      "    compute='_compute_${1:total_amount}',",
      "    store=True,",
      ")",
      "",
      "@api.depends('${3:line_ids.price_subtotal}')",
      "def _compute_${1:total_amount}(self):",
      "    for record in self:",
      "        record.${1:total_amount} = sum(line.${4:price_subtotal} for line in record.${3:line_ids})"
    ],
    "description": "Computed Field definition with depends"
  },
  "Odoo Related Field": {
    "prefix": "ofrel",
    "body": [
      "${1:partner_email} = fields.Char(",
      "    related='${2:partner_id}.${3:email}',",
      "    string='${4:Email}',",
      "    store=${5|True,False|},",
      "    readonly=True,",
      ")"
    ],
    "description": "Related Field definition"
  },
  "Odoo Binary & Filename Fields": {
    "prefix": "ofbin",
    "body": [
