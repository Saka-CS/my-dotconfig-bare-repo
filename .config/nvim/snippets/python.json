      "",
      "@tagged('post_install', '-at_install')",
      "class Test${1:Feature}(TransactionCase):",
      "",
      "    @classmethod",
      "    def setUpClass(cls):",
      "        super().setUpClass()",
      "        cls.${2:partner} = cls.env['res.partner'].create({",
      "            'name': 'Test Partner',",
      "        })",
      "",
      "    def test_${3:something}(self):",
      "        \"\"\" Test description \"\"\"",
      "        self.assertTrue(self.${2:partner}.id)",
      "        $0"
    ],
    "description": "Odoo 17/18 TransactionCase Test Boilerplate"
