      "    default=fields.Datetime.now,",
      ")"
    ],
    "description": "Datetime Field definition"
  },
  "Odoo Many2one Field": {
    "prefix": "ofm2o",
    "body": [
      "${1:partner_id} = fields.Many2one(",
      "    comodel_name='${2:res.partner}',",
      "    string='${3:Partner}',",
      "    ondelete='${4|set null,restrict,cascade|}',",
      "    index=True,",
      ")"
    ],
    "description": "Many2one Field definition"
  },
