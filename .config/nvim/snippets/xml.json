{
  "Odoo XML Root": {
    "prefix": "oxml",
    "body": [
      "<?xml version=\"1.0\" encoding=\"utf-8\"?>",
      "<odoo>",
      "    $0",
      "</odoo>"
    ],
    "description": "Odoo XML Document Root"
  },
  "Odoo Generic Record": {
    "prefix": "orec",
    "body": [
      "<record id=\"${1:record_id}\" model=\"${2:model.name}\">",
      "    <field name=\"${3:name}\">${4:value}</field>",
      "    $0",
      "</record>"
    ],
    "description": "Generic Odoo Record"
  },
  "Odoo 18 Form View with Chatter": {
    "prefix": "ovform",
    "body": [
      "<record id=\"view_${1:model_name}_form\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:model_name}.form</field>",
      "    <field name=\"model\">${2:model.name}</field>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <form string=\"${3:Title}\">",
      "            <header>",
      "                <button name=\"action_${4:confirm}\" string=\"${5:Confirm}\" type=\"object\" class=\"oe_highlight\" invisible=\"state != 'draft'\"/>",
      "                <field name=\"state\" widget=\"statusbar\" statusbar_visible=\"draft,done\"/>",
      "            </header>",
      "            <sheet>",
      "                <div class=\"oe_title\">",
      "                    <h1>",
      "                        <field name=\"name\" placeholder=\"e.g. Reference\"/>",
      "                    </h1>",
      "                </div>",
      "                <group>",
      "                    <group>",
      "                        <field name=\"${6:partner_id}\"/>",
      "                    </group>",
      "                    <group>",
      "                        <field name=\"${7:date}\"/>",
      "                    </group>",
      "                </group>",
      "            </sheet>",
      "            <chatter/>",
      "        </form>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo 18 Form View with inline invisible & <chatter/>"
  },
  "Odoo 18 Wizard Form View": {
    "prefix": "ovwizard",
    "body": [
      "<record id=\"view_${1:wizard_model}_form\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:wizard_model}.form</field>",
      "    <field name=\"model\">${2:wizard.model}</field>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <form string=\"${3:Wizard Title}\">",
      "            <group>",
      "                <field name=\"${4:field_name}\"/>",
      "            </group>",
      "            <footer>",
      "                <button name=\"action_confirm\" string=\"${5:Confirm}\" type=\"object\" class=\"btn-primary\"/>",
      "                <button string=\"Cancel\" class=\"btn-secondary\" special=\"cancel\"/>",
      "            </footer>",
      "        </form>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo 18 Wizard Form View with footer buttons"
  },
  "Odoo 18 List View (<list>)": {
    "prefix": "ovlist",
    "body": [
      "<record id=\"view_${1:model_name}_list\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:model_name}.list</field>",
      "    <field name=\"model\">${2:model.name}</field>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <list string=\"${3:Title}\">",
      "            <field name=\"name\"/>",
      "            <field name=\"${4:partner_id}\"/>",
      "            <field name=\"${5:state}\" widget=\"badge\" decoration-info=\"state == 'draft'\" decoration-success=\"state == 'done'\"/>",
      "        </list>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo 18 List View"
  },
  "Odoo 18 Kanban View": {
    "prefix": "ovkanban",
    "body": [
      "<record id=\"view_${1:model_name}_kanban\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:model_name}.kanban</field>",
      "    <field name=\"model\">${2:model.name}</field>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <kanban default_group_by=\"${3:state}\" class=\"o_kanban_small_column\">",
      "            <field name=\"id\"/>",
      "            <field name=\"name\"/>",
      "            <templates>",
      "                <t t-name=\"card\">",
      "                    <div class=\"d-flex flex-column\">",
      "                        <strong class=\"o_kanban_record_title\">",
      "                            <field name=\"name\"/>",
      "                        </strong>",
      "                        <div class=\"text-muted\">",
      "                            <field name=\"${4:partner_id}\"/>",
      "                        </div>",
      "                    </div>",
      "                </t>",
      "            </templates>",
      "        </kanban>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo 18 Kanban View with <t t-name=\"card\">"
  },
  "Odoo 18 Search View": {
    "prefix": "ovsearch",
    "body": [
      "<record id=\"view_${1:model_name}_search\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:model_name}.search</field>",
      "    <field name=\"model\">${2:model.name}</field>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <search string=\"Search ${3:Title}\">",
      "            <field name=\"name\"/>",
      "            <field name=\"${4:partner_id}\"/>",
      "            <filter string=\"Draft\" name=\"draft\" domain=\"[('state', '=', 'draft')]\"/>",
      "            <filter string=\"Done\" name=\"done\" domain=\"[('state', '=', 'done')]\"/>",
      "            <separator/>",
      "            <filter string=\"Archived\" name=\"inactive\" domain=\"[('active', '=', False)]\"/>",
      "            <group expand=\"0\" string=\"Group By\">",
      "                <filter string=\"Partner\" name=\"group_partner\" context=\"{'group_by': '${4:partner_id}'}\"/>",
      "                <filter string=\"Status\" name=\"group_state\" context=\"{'group_by': 'state'}\"/>",
      "            </group>",
      "        </search>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo Search View definition"
  },
  "Odoo 18 Action Window": {
    "prefix": "oact",
    "body": [
      "<record id=\"action_${1:model_name}\" model=\"ir.actions.act_window\">",
      "    <field name=\"name\">${2:Action Title}</field>",
      "    <field name=\"res_model\">${3:model.name}</field>",
      "    <field name=\"view_mode\">list,form</field>",
      "    <field name=\"help\" type=\"html\">",
      "        <p class=\"o_view_nocontent_smiling_face\">",
      "            Create a new ${2:record}",
      "        </p>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo 18 Window Action"
  },
  "Odoo Menu Structure": {
    "prefix": "omenu",
    "body": [
      "<menuitem id=\"menu_${1:module}_root\" name=\"${2:App Name}\" sequence=\"${3:10}\"/>",
      "<menuitem id=\"menu_${1:module}_category\" name=\"${4:Management}\" parent=\"menu_${1:module}_root\" sequence=\"1\"/>",
      "<menuitem id=\"menu_${1:module}_${5:record}\" name=\"${6:Records}\" parent=\"menu_${1:module}_category\" action=\"action_${5:record}\" sequence=\"1\"/>"
    ],
    "description": "Odoo 3-tier Menu Item structure"
  },
  "Odoo View Inheritance (XPath)": {
    "prefix": "ovinherit",
    "body": [
      "<record id=\"view_${1:model_name}_inherit_${2:feature}\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:model_name}.inherit.${2:feature}</field>",
      "    <field name=\"model\">${3:model.name}</field>",
      "    <field name=\"inherit_id\" ref=\"${4:base_module.view_id}\"/>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <xpath expr=\"//field[@name='${5:target_field}']\" position=\"${6|after,before,inside,replace,attributes|}\">",
      "            <field name=\"${7:new_field}\"/>",
      "        </xpath>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo View Inheritance via XPath"
  },
  "Odoo 18 List View Inheritance (XPath)": {
    "prefix": "ovinheritlist",
    "body": [
      "<record id=\"view_${1:model_name}_list_inherit_${2:feature}\" model=\"ir.ui.view\">",
      "    <field name=\"name\">${1:model_name}.list.inherit.${2:feature}</field>",
      "    <field name=\"model\">${3:model.name}</field>",
      "    <field name=\"inherit_id\" ref=\"${4:base_module.view_id}\"/>",
      "    <field name=\"arch\" type=\"xml\">",
      "        <xpath expr=\"//list/field[@name='${5:target_field}']\" position=\"${6|after,before|}\">",
      "            <field name=\"${7:new_field}\"/>",
      "        </xpath>",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo 18 List View Inheritance via XPath (<list>)"
  },
  "Odoo Notebook and Page with Editable List": {
    "prefix": "ovnotebook",
    "body": [
      "<notebook>",
      "    <page string=\"${1:Lines}\" name=\"${2:lines}\">",
      "        <field name=\"${3:line_ids}\">",
      "            <list editable=\"${4|bottom,top|}\">",
      "                <field name=\"${5:name}\"/>",
      "                <field name=\"${6:amount}\"/>",
      "            </list>",
      "        </field>",
      "    </page>",
      "</notebook>"
    ],
    "description": "Odoo Notebook with Page containing an editable <list>"
  },
  "Odoo Stat Button (Smart Button)": {
    "prefix": "ovstatbutton",
    "body": [
      "<div class=\"oe_button_box\" name=\"button_box\">",
      "    <button name=\"${1:action_view_records}\" type=\"object\" class=\"oe_stat_button\" icon=\"${2:fa-bars}\">",
      "        <field name=\"${3:record_count}\" widget=\"statinfo\" string=\"${4:Items}\"/>",
      "    </button>",
      "</div>"
    ],
    "description": "Odoo Form View Smart Stat Button"
  },
  "Odoo Search Panel": {
    "prefix": "ovsearchpanel",
    "body": [
      "<searchpanel>",
      "    <field name=\"${1:category_id}\" icon=\"fa-folder\" enable_counters=\"1\" select=\"multi\"/>",
      "    <field name=\"${2:state}\" icon=\"fa-filter\" enable_counters=\"1\"/>",
      "</searchpanel>"
    ],
    "description": "Odoo Search Panel definition for search views"
  },
  "Odoo Record Rule (ir.rule)": {
    "prefix": "orule",
    "body": [
      "<record id=\"${1:model_name}_rule_${2:user}\" model=\"ir.rule\">",
      "    <field name=\"name\">${3:Rule Description}</field>",
      "    <field name=\"model_id\" ref=\"model_${4:model_name}\"/>",
      "    <field name=\"domain_force\">[('create_uid', '=', user.id)]</field>",
      "    <field name=\"groups\" eval=\"[(4, ref('${5:base.group_user}'))]\"/>",
      "    <field name=\"perm_read\" eval=\"True\"/>",
      "    <field name=\"perm_write\" eval=\"True\"/>",
      "    <field name=\"perm_create\" eval=\"True\"/>",
      "    <field name=\"perm_unlink\" eval=\"False\"/>",
      "</record>"
    ],
    "description": "Odoo ir.rule Record Rule definition"
  },
  "Odoo Security Group (res.groups)": {
    "prefix": "ogroup",
    "body": [
      "<record id=\"group_${1:feature}_${2:user}\" model=\"res.groups\">",
      "    <field name=\"name\">${3:User Group Title}</field>",
      "    <field name=\"category_id\" ref=\"${4:base.module_category_hidden}\"/>",
      "    <field name=\"implied_ids\" eval=\"[(4, ref('base.group_user'))]\"/>",
      "</record>"
    ],
    "description": "Odoo res.groups Security Group definition"
  },
  "Odoo Server Action (ir.actions.server)": {
    "prefix": "oactserver",
    "body": [
      "<record id=\"action_${1:action_name}\" model=\"ir.actions.server\">",
      "    <field name=\"name\">${2:Action Title}</field>",
      "    <field name=\"model_id\" ref=\"model_${3:model_name}\"/>",
      "    <field name=\"binding_model_id\" ref=\"model_${3:model_name}\"/>",
      "    <field name=\"binding_view_types\">list,form</field>",
      "    <field name=\"state\">code</field>",
      "    <field name=\"code\">",
      "        records.${4:action_method}()",
      "    </field>",
      "</record>"
    ],
    "description": "Odoo ir.actions.server Server Action definition"
  },
  "Odoo Cron Job (ir.cron)": {
    "prefix": "ocron",
    "body": [
      "<record id=\"ir_cron_${1:job_name}\" model=\"ir.cron\">",
      "    <field name=\"name\">${2:Cron Job Title}</field>",
      "    <field name=\"model_id\" ref=\"model_${3:model_name}\"/>",
      "    <field name=\"state\">code</field>",
      "    <field name=\"code\">model.${4:cron_method}()</field>",
      "    <field name=\"interval_number\">1</field>",
      "    <field name=\"interval_type\">${5|days,hours,weeks,months|}</field>",
      "    <field name=\"active\" eval=\"True\"/>",
      "</record>"
    ],
    "description": "Odoo Scheduled Action (ir.cron)"
  },
  "Odoo QWeb Report Action": {
    "prefix": "oreport",
    "body": [
      "<record id=\"action_report_${1:model_name}\" model=\"ir.actions.report\">",
      "    <field name=\"name\">${2:Report Title}</field>",
      "    <field name=\"model\">${3:model.name}</field>",
      "    <field name=\"report_type\">qweb-pdf</field>",
      "    <field name=\"report_name\">${4:module}.${1:model_name}_template</field>",
      "    <field name=\"report_file\">${4:module}.${1:model_name}_template</field>",
      "    <field name=\"binding_model_id\" ref=\"model_${3:model_name}\"/>",
      "    <field name=\"binding_type\">report</field>",
      "</record>"
    ],
    "description": "Odoo PDF Report Action definition"
  },
  "Odoo OWL XML Template Root": {
    "prefix": "oowlxml",
    "body": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<templates xml:space=\"preserve\">",
      "    <t t-name=\"${1:module_name}.${2:ComponentName}\">",
      "        <div class=\"${3:container_class}\">",
      "            $0",
      "        </div>",
      "    </t>",
      "</templates>"
    ],
    "description": "Odoo OWL 2 XML Template Root"
  }
}
