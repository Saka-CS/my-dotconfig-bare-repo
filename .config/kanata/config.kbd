;; Kanata docs
;; https://github.com/jtroo/kanata/blob/main/docs/config.adoc

;; Key code mappings
;; https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs

;; Online Keyboard key press into key code
;; https://www.toptal.com/developers/keycode

;; Online keyboard timing test
;; https://developer.mozilla.org/en-US/play?id=hGktx4JrcvXgr4aNTMJ0WIA1Ned0EwTN7WU2pDMfsf3PWPdfyo%2Fe2zugta9gfd5U7jC10soQWLNQZdSr

(deftemplate homerowmod (char mod)
  (tap-hold-release 0 150 $char $mod  (require-prior-idle 120))
)

(deftemplate v- (key)
  (defvirtualkeys (concat v- $key) $key)
  (defalias (concat v- $key)
    (multi (on-press press-vkey (concat v- $key))
           (on-release release-vkey (concat v- $key))))
)

(t! v- bspc)
(t! v- ent)
(t! v- tab)
(t! v- del)

(defcfg
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
    "BY Tech Gaming Keyboard"
    "Fnatic Gear Fnatic Gear STREAK60 Keyboard"
  )
  linux-continue-if-no-devs-found yes
  log-layer-changes no
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defvar
  chord-timeout 40
)

(defsrc
  caps
  u i o p
  h j k l scln
  a s d f
  spc
)

(defalias
  nav (layer-while-held nav)
  passLayer (layer-switch pass-through)
  baseLayer (layer-switch base)
  spcnav (tap-hold 200 200 spc @nav)

  a    (t! homerowmod a lmet)
  s    (t! homerowmod s lalt)
  d    (t! homerowmod d lctl)
  f    (t! homerowmod f lsft)
  j    (t! homerowmod j rsft)
  k    (t! homerowmod k rctl)
  l    (t! homerowmod l ralt)
  scln (t! homerowmod scln rmet)
)

(defchordsv2
  (esc  1)   @baseLayer    $chord-timeout   all-released   ()
  (esc  2)   @passLayer    $chord-timeout   all-released   ()


  (esc          ralt)   lrld-prev   $chord-timeout    all-released    ()
  (esc   nonusbslash)   lrld        $chord-timeout    all-released    ()
  (esc          rctl)   lrld-next   $chord-timeout    all-released    ()

  (w    e)    @v-bspc    $chord-timeout    all-released    ()
  (e    r)    @v-ent     $chord-timeout    all-released    ()
  (c    v)    @v-tab     $chord-timeout    all-released    ()
  (x    c)    @v-del     $chord-timeout    all-released    ()

  (u    i)    @v-ent     $chord-timeout    all-released    ()
  (i    o)    @v-bspc    $chord-timeout    all-released    ()
  (n    m)    @v-tab     $chord-timeout    all-released    ()
  (m    ,)    @v-del     $chord-timeout    all-released    ()
)

(deflayer base
  esc
  u    i    o    p
  h    @j   @k   @l   @scln
  @a   @s   @d   @f
  @spcnav
)

(deflayer nav
  XX
  home pgup pgdn end
  left down up   rght   _
  _    _    _    _
  XX
)

(deflayermap pass-through
  CapsLock esc
)
