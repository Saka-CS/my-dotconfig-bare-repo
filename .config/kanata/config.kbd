;; Kanata docs
;; https://github.com/jtroo/kanata/blob/main/docs/config.adoc

;; Key code mappings
;; https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs

;; Online key to key code
;; https://www.toptal.com/developers/keycode

(deftemplate homerowmod (char mod)
  (switch
    ((key-timing 3 less-than 150)) $char break
    () (tap-hold-release 0 200 $char $mod) break
  )
)

(defcfg
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
    "BY Tech Gaming Keyboard"
  )
  linux-continue-if-no-devs-found yes
  log-layer-changes no
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  caps
  u i o p
  h j k l scln
  a s d f
  spc
)

(defalias
  nav (layer-while-held nav)
  passLayer (layer-switch pass-through)
  baseLayer (layer-switch base)
  spcnav (tap-hold 200 200 spc @nav)

  a    (t! homerowmod a lmet)
  s    (t! homerowmod s lalt)
  d    (t! homerowmod d lctl)
  f    (t! homerowmod f lsft)
  j    (t! homerowmod j rsft)
  k    (t! homerowmod k rctl)
  l    (t! homerowmod l ralt)
  scln (t! homerowmod scln rmet)
)

(defchordsv2
  (esc 1)   @baseLayer    100   first-release ()
  (esc 2)   @passLayer    100   first-release ()
)

(deflayer base
  esc
  u    i    o    p
  h    @j   @k   @l   @scln
  @a   @s   @d   @f
  @spcnav
)

(deflayer nav
  XX
  home pgup pgdn end
  left down up   rght   _
  _    _    _    _
  XX
)

(deflayermap pass-through
  CapsLock esc
  ContextMenu lrld
  rctl lrld-next
  ralt lrld-prev
)
