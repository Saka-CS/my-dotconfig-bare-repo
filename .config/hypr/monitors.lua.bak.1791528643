-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

local omarchy_gdk_scale = 1
local omarchy_monitor_scale = 1

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- Pin workspaces 1-9 to the primary monitor and 10 to the secondary, but only
-- when those monitors are actually connected (so this works on laptops too).
-- Support both monitor naming schemes used across configs/machines:
--   * DP-1  + HDMI-A-2  (current setup)
--   * DP-4  + HDMI-A-3  (previous/alternate setup)
local function monitor_connected(name)
  return o.shell_succeeds(
    'for d in /sys/class/drm/card*-' .. name .. '; do [ -e "$d" ] && [ "$(cat "$d/status" 2>/dev/null)" = "connected" ] && exit 0; done; exit 1')
end

local primary_candidates = { "DP-1", "DP-4" }
local secondary_candidates = { "HDMI-A-2", "HDMI-A-3" }

for _, mon in ipairs(primary_candidates) do
  if monitor_connected(mon) then
    for i = 1, 9 do
      hl.workspace_rule({ workspace = tostring(i), monitor = mon })
    end
    hl.workspace_rule({ workspace = "1", monitor = mon, default = true })
  end
end

for _, mon in ipairs(secondary_candidates) do
  if monitor_connected(mon) then
    hl.workspace_rule({ workspace = "10", monitor = mon, persistent = true, default = true })
  end
end

-- Configure a specific monitor.
-- hl.monitor({ output = "DP-2", mode = "2560x1440@144", position = "0x0", scale = 1 })

-- Portrait/rotated secondary monitor (transform: 1 = 90°, 3 = 270°).
-- hl.monitor({ output = "DP-2", mode = "preferred", position = "auto", scale = 1, transform = 1 })
